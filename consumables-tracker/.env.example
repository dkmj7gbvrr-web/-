# Vercel Postgres / Neon などの接続文字列を設定してください
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# プッシュ通知を使う場合のみ必要(任意)。生成方法はREADME参照。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# デプロイ先の https:// URL を指定してください。mailto: でも良いですが、
# 存在しないドメインだとiPhone(Apple)でプッシュ送信が403で失敗します。
VAPID_SUBJECT="https://your-app.vercel.app"
CRON_SECRET=""
