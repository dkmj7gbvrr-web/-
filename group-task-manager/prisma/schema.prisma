// TaskCircle — グループでタスクを共有するアプリのデータ定義。
//
// アカウント登録(メール・パスワード)は持たない。初回に入力した表示名で
// User を1件つくり、その id をブラウザのCookieに保存して本人確認とする。
// 別端末・キャッシュ削除後の復帰用に loginCode(一意)も発行する。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MEMBER
}

enum TaskVisibility {
  PRIVATE
  GROUP
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DelegationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  DELEGATION_REQUEST
  DELEGATION_APPROVED
  DELEGATION_REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  loginCode String?  @unique
  createdAt DateTime @default(now())

  memberships         GroupMember[]
  ownedGroups         Group[]           @relation("GroupOwner")
  ownedTasks          Task[]            @relation("TaskOwner")
  assignedTasks       Task[]            @relation("TaskAssignee")
  participations      TaskParticipant[]
  sentDelegations     TaskDelegation[]  @relation("DelegationFrom")
  receivedDelegations TaskDelegation[]  @relation("DelegationTo")
  notifications       Notification[]
  attachments         Attachment[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  tasks   Task[]
}

model GroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Task {
  id              String         @id @default(cuid())
  groupId         String
  ownerId         String
  assigneeId      String?
  title           String
  normalizedTitle String
  description     String?
  visibility      TaskVisibility @default(PRIVATE)
  status          TaskStatus     @default(TODO)
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  owner         User              @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee      User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  participants  TaskParticipant[]
  delegations   TaskDelegation[]
  notifications Notification[]

  @@index([groupId, visibility])
  @@index([groupId, normalizedTitle])
}

/// グループ公開タスクに「参加しているメンバー」と、各メンバーごとの
/// 個別の完了チェック。Aさんは完了・Bさんは未完了、を1つのタスクの中で
/// 別々に管理する。
model TaskParticipant {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  completed   Boolean   @default(false)
  completedAt DateTime?
  joinedAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskDelegation {
  id              String           @id @default(cuid())
  taskId          String
  fromUserId      String
  toUserId        String
  status          DelegationStatus @default(PENDING)
  message         String?
  attachmentId    String?          @unique
  responseComment String?
  createdAt       DateTime         @default(now())
  respondedAt     DateTime?

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  from       User        @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User        @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id])

  @@index([toUserId, status])
}

/// 承認依頼に添付するファイル。実データはPostgreSQLにそのまま保存する
/// (別のストレージサービスを増やさないための軽量構成)。
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  delegation TaskDelegation?
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  taskId     String?
  fromUserId String?
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
