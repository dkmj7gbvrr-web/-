// Prisma schema for the group task manager app.
// SQLite has no native enum type, so status/role/type-like fields are
// plain String columns, validated with zod at the application boundary.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  teamsWebhookUrl String?
  createdAt       DateTime @default(now())

  memberships       GroupMember[]
  ownedGroups       Group[]              @relation("GroupOwner")
  ownedTasks        Task[]               @relation("TaskOwner")
  assignedTasks     Task[]               @relation("TaskAssignee")
  sentDelegations   TaskDelegation[]     @relation("DelegationFrom")
  receivedDelegations TaskDelegation[]   @relation("DelegationTo")
  notifications     Notification[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members GroupMember[]
  tasks   Task[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER") // OWNER | MEMBER
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Task {
  id              String    @id @default(cuid())
  groupId         String
  ownerId         String
  assigneeId      String?
  title           String
  normalizedTitle String
  description     String?
  visibility      String    @default("PRIVATE") // PRIVATE | GROUP
  status          String    @default("TODO") // TODO | IN_PROGRESS | DONE
  dueDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  owner        User             @relation("TaskOwner", fields: [ownerId], references: [id])
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  delegations  TaskDelegation[]
  notifications Notification[]

  @@index([groupId, visibility])
  @@index([groupId, normalizedTitle])
}

model TaskDelegation {
  id          String    @id @default(cuid())
  taskId      String
  fromUserId  String
  toUserId    String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELED
  message     String?
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  from User @relation("DelegationFrom", fields: [fromUserId], references: [id])
  to   User @relation("DelegationTo", fields: [toUserId], references: [id])

  @@index([toUserId, status])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String // DELEGATION_REQUEST | DELEGATION_APPROVED | DELEGATION_REJECTED
  taskId      String?
  fromUserId  String?
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
