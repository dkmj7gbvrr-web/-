// TaskCircle — グループでタスクを共有するアプリのデータ定義。
//
// アカウント登録(メール・パスワード)は持たない。初回に入力した表示名で
// User を1件つくり、その id をブラウザのCookieに保存して本人確認とする。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MEMBER
}

enum TaskVisibility {
  PRIVATE
  GROUP
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DelegationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  DELEGATION_REQUEST
  DELEGATION_APPROVED
  DELEGATION_REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships         GroupMember[]
  ownedGroups         Group[]          @relation("GroupOwner")
  ownedTasks          Task[]           @relation("TaskOwner")
  assignedTasks       Task[]           @relation("TaskAssignee")
  sentDelegations     TaskDelegation[] @relation("DelegationFrom")
  receivedDelegations TaskDelegation[] @relation("DelegationTo")
  notifications       Notification[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  tasks   Task[]
}

model GroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Task {
  id              String         @id @default(cuid())
  groupId         String
  ownerId         String
  assigneeId      String?
  title           String
  normalizedTitle String
  description     String?
  visibility      TaskVisibility @default(PRIVATE)
  status          TaskStatus     @default(TODO)
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  owner         User             @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  delegations   TaskDelegation[]
  notifications Notification[]

  @@index([groupId, visibility])
  @@index([groupId, normalizedTitle])
}

model TaskDelegation {
  id          String           @id @default(cuid())
  taskId      String
  fromUserId  String
  toUserId    String
  status      DelegationStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  from User @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  taskId     String?
  fromUserId String?
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
